##
## Copy this file to `backend/.env` and `frontend/.env.local` and fill in the
## values you need. Nothing here is required to run locally except the admin
## credentials you want to log in with.
##

########################################
# BACKEND  ->  backend/.env
########################################

# Port the Express API listens on.
PORT=4000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# If this is EMPTY, the API falls back to an in-process store so you can run
# the project with zero setup (data is written to backend/.data/dev-db.json).
# Set it for real persistence — this is required in production.
#   Local:  mongodb://127.0.0.1:27017/personal-blog
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/personal-blog?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign admin JWTs. MUST be set in production, and must be at
# least 32 characters (the server refuses to boot otherwise). Generate one
# with:  openssl rand -base64 48
JWT_SECRET=

# How long an admin session lasts.
JWT_EXPIRES_IN=30d

# Comma-separated list of browser origins allowed to call the API.
# Matching is EXACT-MATCH ONLY: no wildcard subdomain patterns (e.g.
# *.vercel.app) and no "*" — anyone can register those subdomains, and the API
# sends credentials. `CORS_ORIGINS="*"` is refused at boot in production.
# In production this is your Vercel URL, e.g. https://your-blog.vercel.app
CORS_ORIGINS=http://localhost:3000

# The single admin account. `npm run seed` creates or updates this account.
# Change the password before deploying anywhere public — the default is
# refused at boot in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Your Name

# Cloudinary (optional). If all three are set, image uploads go to Cloudinary;
# otherwise they are written to backend/uploads/ and served from there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


########################################
# FRONTEND  ->  frontend/.env.local
########################################

# Where the Next.js server (and its /api proxy) reaches the Express API.
# Server-side only — never exposed to the browser.
#   Local:      http://localhost:4000
#   Production: https://your-api.onrender.com
API_URL=http://localhost:4000

# Public site URL. Used for canonical links, Open Graph tags, RSS and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How long (seconds) ISR caches API responses before revalidating.
NEXT_PUBLIC_REVALIDATE_SECONDS=60

# Whether AI *training* crawlers (GPTBot, ClaudeBot, CCBot, Google-Extended)
# may read the site. Set to "false" to block them in robots.txt.
# AI *search* crawlers that cite sources and send traffic (OAI-SearchBot,
# PerplexityBot, Claude-SearchBot, ...) are always allowed and are unaffected.
# Note: Google-Extended has no effect on normal Google Search ranking.
ALLOW_AI_TRAINING_CRAWLERS=true
